# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，不会进入 Git 仓库。
# 也可以用系统环境变量提供，二者等效。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：最大迭代轮数、单次任务最大工具调用次数、单次模型调用超时（秒）
# AGENT_MAX_TURNS=30
# AGENT_MAX_TOOL_CALLS=80
# AGENT_TIMEOUT=120

# 可选：上下文管理
# AGENT_MAX_CONTEXT_TOKENS=40000      # token 预算，超出时裁剪/摘要
# AGENT_TOOL_RESULT_MAX_CHARS=8000    # 单个工具结果进上下文前的字符上限
# AGENT_ENABLE_SUMMARIZATION=1        # 1=超预算时摘要旧历史；0=直接丢弃
